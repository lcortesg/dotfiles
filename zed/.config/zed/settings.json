{
  "project_panel": {
    "dock": "left"
  },
  "icon_theme": "Catppuccin Frappé",
  "ssh_connections": [
    {
      "host": "server-gsp",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/lucas"
          ]
        },
        {
          "paths": [
            "/opt/monitor"
          ]
        },
        {
          "paths": [
            "/root"
          ]
        }
      ]
    },
    {
      "host": "vps",
      "args": [],
      "projects": []
    },
    {
      "host": "vps",
      "args": [],
      "projects": []
    }
  ],
  "agent": {
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-3-5-sonnet-20240620"
    },
  },
  "features": {
    "edit_prediction_provider": "none"
  },
  "ui_font_size": 14,
  "buffer_font_size": 13,
  "buffer_font_family": "MesloLGL Nerd Font",
  "soft_wrap": "editor_width",
  "theme": {
    "mode": "system",
    "light": "Ayu Dark",
    "dark": "Catppuccin Frappé"
  },
  "terminal": {
    "dock": "bottom",
    "font_family": "MesloLGL Nerd Font",
    "font_size": 12
  }
